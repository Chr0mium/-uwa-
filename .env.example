# Copy to the repository root as .env for Docker Compose or backend development.
# The root .env is git-ignored.

# Backend
# Local offline demo only. In production leave this UNSET or false so the app
# serves real Elexon data or errors (503) — never mock. (Code default is false.)
USE_MOCK_DATA=false
ALLOWED_ORIGINS=*

# Frontend Docker build argument; Vite bakes this into the production bundle.
VITE_API_URL=http://localhost:8000